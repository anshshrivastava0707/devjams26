# Copy this file to .env and fill in real values. .env is gitignored.

# Required for client.py's interactive LangChain agent mode (the default
# when running client.py with no arguments). Get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Overrides the default model used by the agent (gemini-2.5-flash).
GEMINI_MODEL=
